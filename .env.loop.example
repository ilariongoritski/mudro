# Optional local Loop Engineering / autonomy settings.
# Copy to .env.loop locally; never put live tokens or keys in this file.

# GitHub fine-grained token (keep empty until configured locally)
GITHUB_TOKEN=

# Telegram reporting
TELEGRAM_BOT_TOKEN=
REPORT_BOT_TOKEN=
REPORT_CHAT_ID=
REPORT_INTERVAL_MIN=30

# Agent configuration
HERMES_MAX_TURNS=120
HERMES_REASONING_EFFORT=high
HERMES_WORKER_TURNS=30
HERMES_WORKER_MODEL=minimax-m3

# Optional Kanban integration
KANBAN_PROVIDER=linear
LINEAR_API_KEY=

# Monitoring
MONITOR_CRON_ENABLED=true
MONITOR_INTERVAL_MIN=15
AUTO_RESTART_ON_DOWN=true

# Loop Engineering
LOOP_ENABLED=true
LOOP_CRON="0 10 * * *"
LOOP_YOLO=false
LOOP_MAX_FILES=25
LOOP_MAX_LINES=800
